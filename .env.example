# 필수
NEXT_PUBLIC_SUPABASE_URL=       # Supabase 프로젝트 URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # Supabase anon key
ALADDIN_TTB_KEY=                # 알라딘 TTBKey (서버 전용) — https://www.aladin.co.kr/ttb/wapui/wapi_guide.aspx

# 선택
SUPABASE_DB_URL=                # Supabase DB 접속 URI — node scripts/migrate.mjs 실행 시
NEXT_PUBLIC_SITE_URL=           # 배포 도메인 (OG·sitemap 절대 URL). 없으면 Vercel URL → localhost:3000
